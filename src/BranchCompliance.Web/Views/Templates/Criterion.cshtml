@model CriterionForm
@{ ViewData["Title"] = Model.Id is null ? "Add a criterion" : "Edit criterion"; }
<section class="card form-page"><div class="card-body p-4"><form asp-action="Criterion" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="TemplateId" type="hidden" /><input asp-for="Id" type="hidden" />
    <div class="mb-3"><label asp-for="CategoryId" class="form-label">Category</label><select asp-for="CategoryId" asp-items="Model.Categories" class="form-select" required><option value="">Choose a category</option></select></div>
    <div class="mb-3"><label asp-for="Code" class="form-label">Criterion code</label><input asp-for="Code" class="form-control" maxlength="24" required /></div>
    <div class="mb-3"><label asp-for="Title" class="form-label">Criterion title</label><input asp-for="Title" class="form-control" maxlength="160" required /></div>
    <div class="mb-3"><label asp-for="Guidance" class="form-label">Guidance for the branch and Assessor</label><textarea asp-for="Guidance" class="form-control" rows="4" maxlength="2000" required></textarea></div>
    <div class="row"><div class="col-sm-6 mb-3"><label asp-for="Weight" class="form-label">Weight (%)</label><input asp-for="Weight" class="form-control" type="number" min="0.01" max="100" step="0.01" required /></div><div class="col-sm-6 mb-3"><label asp-for="Order" class="form-label">Display order</label><input asp-for="Order" class="form-control" type="number" min="0" max="999" required /></div></div>
    <div class="form-check mb-4"><input asp-for="EvidenceRequired" class="form-check-input" /><label asp-for="EvidenceRequired" class="form-check-label">Require protected evidence before submission</label></div>
    <button class="btn btn-primary" type="submit">Save criterion</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.TemplateId">Cancel</a>
</form></div></section>
