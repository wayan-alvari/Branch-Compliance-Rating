@model BranchCompliance.Domain.Templates.AssessmentTemplate
@{
    ViewData["Title"] = Model.Name;
    var draft = Model.State == BranchCompliance.Domain.Templates.TemplateState.Draft;
    var total = Model.Criteria.Sum(row => row.Weight);
}
<section class="card mb-4"><div class="card-body">
    <div class="d-flex justify-content-between gap-3 flex-wrap"><div><span class="status-label">@Model.State · Version @Model.Version</span><p class="mt-3 mb-2">@Model.Description</p><p class="@(total == 100m ? "text-success" : "text-danger") fw-semibold">Total weight: @total.ToString("F2")% · Publishing requires exactly 100.00%</p></div>
    <div class="d-flex gap-2 align-items-start flex-wrap">
    @if (draft)
    {
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit name</a>
        <form asp-action="Publish" asp-route-id="@Model.Id" method="post" data-confirm="Publish this version? Its criteria and rating bands will become read-only."><button class="btn btn-primary" type="submit">Publish version</button></form>
    }
    else
    {
        <form asp-action="NewVersion" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary" type="submit">Create new draft version</button></form>
    }
    </div></div>
    @if (!draft) { <p class="small text-secondary mb-0">This version is read-only. New periods copy these criteria and rating bands when they open.</p> }
</div></section>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><h2 class="h4 mb-0">Criteria preview</h2>
@if (draft)
{
    <div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Category" asp-route-templateId="@Model.Id">Add category</a><a class="btn btn-primary" asp-action="Criterion" asp-route-templateId="@Model.Id">Add criterion</a></div>
}
</div>
@if (Model.Categories.Count == 0) { <div class="alert alert-light border">Add a category, then add its criteria and weights.</div> }
@foreach (var category in Model.Categories.OrderBy(row => row.Order).ThenBy(row => row.Name))
{
    <section class="card mb-3"><div class="card-header bg-transparent d-flex align-items-center gap-3 flex-wrap"><h3 class="h5 mb-0">@category.Name</h3>
    @if (draft)
    {
        <a class="ms-auto small" asp-action="Category" asp-route-templateId="@Model.Id" asp-route-id="@category.Id">Edit category</a>
        <form asp-action="RemoveCategory" method="post" data-confirm="Remove this empty draft category?"><input type="hidden" name="templateId" value="@Model.Id" /><input type="hidden" name="id" value="@category.Id" /><button class="btn btn-outline-danger btn-sm" type="submit">Remove category</button></form>
    }
    </div><div class="card-body">
    @if (!Model.Criteria.Any(row => row.CategoryId == category.Id)) { <p class="text-secondary">This category has no criteria yet.</p> }
    @foreach (var criterion in Model.Criteria.Where(row => row.CategoryId == category.Id).OrderBy(row => row.Order))
    {
        <article class="criterion-preview"><div class="d-flex justify-content-between gap-3"><h4 class="h6"><code>@criterion.Code</code> · @criterion.Title</h4><strong class="text-nowrap">@criterion.Weight.ToString("F2")%</strong></div><p class="mb-2">@criterion.Guidance</p><p class="small text-secondary">@(criterion.EvidenceRequired ? "Evidence required" : "Evidence optional") · Display order @criterion.Order</p>
        @if (draft)
        {
            <div class="d-flex gap-3 align-items-center"><a asp-action="Criterion" asp-route-templateId="@Model.Id" asp-route-id="@criterion.Id">Edit criterion</a><form asp-action="RemoveCriterion" method="post" data-confirm="Remove this draft criterion? Recheck the total weight before publishing."><input type="hidden" name="templateId" value="@Model.Id" /><input type="hidden" name="id" value="@criterion.Id" /><button class="btn btn-outline-danger btn-sm" type="submit">Remove criterion</button></form></div>
        }
        </article>
    }
    </div></section>
}
<section class="card mt-4"><div class="card-header bg-transparent d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Rating bands</h2>@if (draft) { <a asp-action="Bands" asp-route-id="@Model.Id">Edit bands</a> }</div><div class="card-body">
    <div class="table-responsive"><table class="table"><caption class="visually-hidden">Rating minimums</caption><thead><tr><th>Rating</th><th>Minimum inclusive score</th></tr></thead><tbody>@foreach (var band in Model.Bands.OrderBy(row => row.Order)) { <tr><td>@band.Label</td><td>@band.MinimumInclusive.ToString("F2")</td></tr> }</tbody></table></div>
    <p class="small text-secondary mb-0">Contribution = score × weight / 100. Round only the final sum to two places, with midpoint away from zero. The highest qualifying rating threshold applies.</p>
</div></section>
