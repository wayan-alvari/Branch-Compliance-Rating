@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var role = DemoRoles.All.FirstOrDefault(User.IsInRole);
    var pageTitle = ViewData["Title"]?.ToString() ?? "Branch Compliance & Rating";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle · Branch Compliance &amp; Rating</title>
    <link rel="stylesheet" href="~/vendor/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="app-wrapper">
        <header class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <button class="btn btn-outline-secondary me-3" type="button" data-lte-toggle="sidebar" aria-label="Toggle navigation">Menu</button>
                <a class="navbar-brand brand-wordmark" asp-controller="Home" asp-action="Index">Branch <span>Compliance</span></a>
                <div class="ms-auto d-flex align-items-center gap-3 flex-wrap">
                    @if (signedIn)
                    {
                        <span class="role-pill">@DemoRoles.Label(role ?? "Member")</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="btn btn-outline-secondary btn-sm" type="submit">Log out / switch role</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-secondary small">Independent portfolio</span>
                    }
                </div>
            </div>
        </header>
        <aside class="app-sidebar bg-dark" data-bs-theme="dark" aria-label="Primary navigation">
            <div class="sidebar-brand"><a asp-controller="Dashboard" asp-action="Index" class="brand-link">BC <span class="brand-text fw-light">&amp; Rating</span></a></div>
            <div class="sidebar-wrapper">
                <nav class="mt-3">
                    <ul class="nav sidebar-menu flex-column" role="list">
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">Workspace overview</a></li>
                        @if (User.IsInRole(DemoRoles.Administrator))
                        {
                            <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Branches" ? "active" : "")" asp-controller="Branches" asp-action="Index">Branches</a></li>
                            <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Templates" ? "active" : "")" asp-controller="Templates" asp-action="Index">Assessment templates</a></li>
                            <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Periods" ? "active" : "")" asp-controller="Periods" asp-action="Index">Assessment periods</a></li>
                        }
                        @if (User.IsInRole(DemoRoles.Administrator) || User.IsInRole(DemoRoles.BranchUser))
                        {
                            <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Submissions" ? "active" : "")" asp-controller="Submissions" asp-action="Index">Branch submissions</a></li>
                        }
                        @if (User.IsInRole(DemoRoles.Assessor))
                        {
                            <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Scoring" ? "active" : "")" asp-controller="Scoring" asp-action="Index">Assessment scoring</a></li>
                        }
                        @if (User.IsInRole(DemoRoles.BranchUser))
                        {
                            <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Appeals" ? "active" : "")" asp-controller="Appeals" asp-action="Index">Provisional results &amp; appeals</a></li>
                        }
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" ? "active" : "")" asp-controller="Account" asp-action="Login">Demo roles &amp; sign-in</a></li>
                    </ul>
                </nav>
                <div class="sidebar-note">Clear criteria.<br />Traceable decisions.<br />Transparent results.</div>
            </div>
        </aside>
        <main class="app-main" id="main-content" tabindex="-1">
            @if (Configuration.GetValue<bool>("DemoMode:Enabled"))
            {
                <div class="demo-notice" role="note">Demo data is isolated per browser and automatically resets after 6 hours of inactivity.</div>
            }
            <div class="app-content-header">
                <div class="container-fluid">
                    <nav aria-label="Breadcrumb"><ol class="breadcrumb small"><li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Workspace</a></li><li class="breadcrumb-item active" aria-current="page">@pageTitle</li></ol></nav>
                    <h1 class="h2">@pageTitle</h1>
                </div>
            </div>
            <div class="app-content pb-4"><div class="container-fluid">@RenderBody()</div></div>
        </main>
        <footer class="app-footer"><span>Fictional data · Original MIT portfolio · 2026 Wayan Alvari</span></footer>
    </div>
    <script src="~/vendor/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/adminlte.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
